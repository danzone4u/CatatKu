{
  "expo": {
    "name": "CatatKu",
    "slug": "dompet-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/tagline.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "scheme": "dompet",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dani.catatku",
      "adaptiveIcon": {
        "backgroundColor": "#1B6E67",
        "foregroundImage": "./assets/logo.png"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#1B6E67"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
