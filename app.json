{
  "expo": {
    "name": "CatatKu",
    "slug": "dompet-app",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "userInterfaceStyle": "light",
    "scheme": "dompet",
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dani.catatku",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#1B6E67",
        "foregroundImage": "./assets/logo.png"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#1B6E67"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
